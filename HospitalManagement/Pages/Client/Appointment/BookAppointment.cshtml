<script>

    debugger;
    $(document).ready(function () {

        $("#DepartmentId").change(function () {
          

            var departmentId = $(this).val();

            if (departmentId == "0") {

                $("#DoctorId").html('<option value="0">-- Select Doctor --</option>');
                return;
            }

            $.ajax({

                url: "/Client/Appointment/BookAppointment?handler=DoctorByDepartment",

                type: "GET",

                data: {
                    departmentId: departmentId
                },

                success: function (response) {

                    $("#DoctorId").empty();

                    $("#DoctorId").append('<option value="0">-- Select Doctor --</option>');

                    $.each(response, function (index, item) {

                        $("#DoctorId").append(
                            '<option value="' + item.doctorId + '">' +
                            item.doctorName +
                            '</option>'
                        );

                    });

                },

                error: function (xhr) {

                    console.log(xhr);

                }

            });

        });

    });


    //For Past Time Dont Allow


    $(document).ready(function () {

        $("#AppointmentDate").change(function () {

            var selectedDate = $(this).val();

            var today = new Date().toISOString().split('T')[0];

            if (selectedDate == today) {

                var now = new Date();

                var hours = String(now.getHours()).padStart(2, '0');
                var minutes = String(now.getMinutes()).padStart(2, '0');

                var currentTime = hours + ":" + minutes;

                $("#AppointmentTime").attr("min", currentTime);

            }
            else {

                $("#AppointmentTime").removeAttr("min");

            }

        });

    });


</script>

