                    <form  method="post" enctype="multipart/form-data">
                        <div class="row">


                            <div class="form-group col-md-6 mb-4 position-relative">
                                <label class="mb-2" style="color:white;">Department</label>

                                <select asp-for="PatientAppointment.DepartmentId" id="DepartmentId"
                                        asp-items="Model.DepartmentList"
                                        class="form-control custom-select">

                                    <option value="0">-- Select Department --</option>

                                </select>
                                <span asp-validation-for="PatientAppointment.DepartmentId" class="text-danger"></span>
                            </div>

                            <div class="form-group col-md-6 mb-4">
                                <label class="mb-2" style="color:white;">Select Doctor</label>
                                <select asp-for="PatientAppointment.DoctorId" class="form-control custom-select"  id="DoctorId">
                                   
                                </select>
                                <span asp-validation-for="PatientAppointment.DoctorId" class="text-danger"></span>

                            </div>

                            <div class="form-group col-md-6 mb-4">
                                <label class="mb-2 text-white">Suggested Appointment Date</label>

                                <input class="form-control"
                                       type="date"
                                       asp-for="PatientAppointment.SuggestedDate"
                                       id="AppointmentDate"
                                       min="@DateTime.Now.ToString("yyyy-MM-dd")" />

                                <span asp-validation-for="PatientAppointment.SuggestedDate" class="text-danger"></span>
                            </div>

                            <div class="form-group col-md-6 mb-4">
                                <label class="mb-2 text-white">Suggested Appointment Time</label>

                                <input class="form-control"
                                       type="time"
                                       asp-for="PatientAppointment.SuggestedTime"
                                       id="AppointmentTime" />

                                <span asp-validation-for="PatientAppointment.SuggestedTime" class="text-danger"></span>
                            </div>


                            <div class="form-group col-md-12 mb-4">
                                <label class="mb-2" style="color:white;">Reason </label>
                                <textarea  class="form-control"  asp-for="PatientAppointment.Reason " placeholder="Enter Reason "></textarea>
                                <span asp-validation-for="PatientAppointment.Reason" class="text-danger"></span>
                            </div>



                            
                            <div class="col-lg-12">
                                <div class="contact-form-btn">
                                    <button type="submit" class="btn-default">Book Appointment</button>

                                </div>
                            </div>

                            <div class="appointment-note">
                                <span>
                                    <strong>Note:</strong> Please book appointments only for registered patients.
                                    If the patient is not registered, kindly complete the patient registration process first.
                                </span>
                            </div>

                        </div>
            </form>
        </div>
                            <!-- Contact Form end -->
                        </div>
        </div>
    </div>
</div>
