<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
    select.form-control {
        background: transparent;
        border: none;
        border-bottom: 1px solid #ccc;
        border-radius: 0;
        color: #fff;
        box-shadow: none;
    }

        select.form-control:focus {
            outline: none;
            box-shadow: none;
            border-bottom: 1px solid #fff;
        }

        select.form-control option {
            color: #000; /* dropdown ke andar text black rahe */
        }

    select.form-control {
        appearance: auto;
        -webkit-appearance: auto;
        -moz-appearance: auto;
    }


    .custom-date {
        background: transparent;
        border: none;
        border-bottom: 1px solid #ccc;
        border-radius: 0;
        color: #fff;
    }

        .custom-date:focus {
            outline: none;
            box-shadow: none;
            border-bottom: 1px solid #fff;
        }

        /* Calendar icon white karne ke liye (Chrome based browsers) */
        .custom-date::-webkit-calendar-picker-indicator {
            filter: invert(1);
            cursor: pointer;
        }

    .custom-file {
        background: transparent;
        border: none;
        border-bottom: 1px solid #ccc;
        border-radius: 0;
        color: #fff;
    }

        .custom-file:focus {
            outline: none;
            box-shadow: none;
            border-bottom: 1px solid #fff;
        }

        .appointment-note {
    width: 100%;
    overflow: hidden;
    white-space: nowrap;
    background-color: #fff3cd;
    color: #856404;
    border: 1px solid #ffeeba;
    border-radius: 5px;
    padding: 8px 0;
    margin-top: 15px;
}

.appointment-note span {
    display: inline-block;
    padding-left: 100%;
    animation: scrollNote 15s linear infinite;
}

@@keyframes scrollNote {
    from {
        transform: translateX(0%);
    }
    to {
        transform: translateX(-100%);
    }
}
</style>
