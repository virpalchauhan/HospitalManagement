@page
@model HospitalManagement.Pages.Client.Appointment.SingleAppointmentModel
@{
    Layout = "/Pages/Client/_ClientLayout.cshtml";

}



<div class="page-contact-form">
    <div class="container">
        <div class="row section-row">
            <div class="col-lg-12">
                <div class="section-title">
                    <h3 class="wow fadeInUp">manage account</h3>
                    <h2 class="text-anime-style-3">Update Profile</h2>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">

               
                <div class="contact-us-form wow fadeInUp" data-wow-delay="0.5s">

                    <form method="post" enctype="multipart/form-data">

                        <input type="hidden" asp-for="AppointmentPatientDepartmentInnerJoin.AppointmentId" />

                        <div class="row">

                           
                            <div class="form-group col-md-6 mb-4">
                                <label class="mb-2" style="color:white;">
                                    Doctor Name
                                </label>

                                <input asp-for="AppointmentPatientDepartmentInnerJoin.DoctorName" class="form-control" disabled>

                              
                            </div>

                         
                            <div class="form-group col-md-6 mb-4">
                                <label class="mb-2" style="color:white;">
                                    Department Name
                                </label>

                                <input asp-for="AppointmentPatientDepartmentInnerJoin.DepartmentName"
                                       class="form-control"
                                       disabled>

                               
                            </div>

                           

                            
                            @*<div class="form-group col-md-6 mb-4">
                                <label class="mb-2" style="color:white;">
                                  Your Suggested Date
                                </label>

                                <input asp-for="AppointmentPatientDepartmentInnerJoin.SuggestedDate"
                                       disabled
                                       class="form-control"
                                       >

                             
                            </div>

                            
                            <div class="form-group col-md-6 mb-4">
                                <label class="mb-2" style="color:white;">
                                   Your Suggested Time
                                </label>

                                <input asp-for="AppointmentPatientDepartmentInnerJoin.SuggestedTime"
                                       class="form-control" disabled readonly
                                       placeholder="Enter Mobile Number">

                              
                            </div>*@

                           
                            <div class="form-group col-md-6 mb-4">
                                <label class="mb-2" style="color:white;">
                                    Appointment Date By Doctor
                                </label>

                                <input asp-for="AppointmentPatientDepartmentInnerJoin.SuggestedDate"
                                       class="form-control"
                                       readonly>

                              
                            </div>


                            
                            <div class="form-group col-md-4 mb-4">
                                <label class="mb-2" style="color:white;">
                                    Appointment Time By Doctor
                                </label>

                                <input asp-for="AppointmentPatientDepartmentInnerJoin.SuggestedTime"
                                       class="form-control" readonly
                                      >

                               
                            </div>

                           

                           



                            <!-- Submit Button -->
                            <div class="col-lg-12">
                                <div class="contact-form-btn">
                                    <button asp-page-handler="Accept"
                                            type="submit"
                                            class="btn-default">
                                        Accept
                                    </button>

                                    <button asp-page-handler="Rejected"
                                            type="submit"
                                            class="btn-default">
                                        Rejected
                                    </button>
                                </div>

                               
                            </div>

                        </div>

                    </form>





                </div>

                <!-- Registration Form end -->

            </div>
        </div>
    </div>
</div>


<!-- Toast Container -->

<div class="custom-toast-container"
     id="toastContainer">
</div>



<style>
    select.form-control {
        background: transparent;
        border: none;
        border-bottom: 1px solid #ccc;
        border-radius: 0;
        color: #fff;
        box-shadow: none;
    }

        select.form-control:focus {
            outline: none;
            box-shadow: none;
            border-bottom: 1px solid #fff;
        }

        select.form-control option {
            color: #000; /* dropdown ke andar text black rahe */
        }

    select.form-control {
        appearance: auto;
        -webkit-appearance: auto;
        -moz-appearance: auto;
    }


    .custom-date {
        background: transparent;
        border: none;
        border-bottom: 1px solid #ccc;
        border-radius: 0;
        color: #fff;
    }

        .custom-date:focus {
            outline: none;
            box-shadow: none;
            border-bottom: 1px solid #fff;
        }

        /* Calendar icon white karne ke liye (Chrome based browsers) */
        .custom-date::-webkit-calendar-picker-indicator {
            filter: invert(1);
            cursor: pointer;
        }

    .custom-file {
        background: transparent;
        border: none;
        border-bottom: 1px solid #ccc;
        border-radius: 0;
        color: #fff;
    }

        .custom-file:focus {
            outline: none;
            box-shadow: none;
            border-bottom: 1px solid #fff;
        }

    .readonly-input {
        cursor: not-allowed;
        background-color: #e9ecef;
    }

    .custom-toast-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 999999;
    }



    .custom-toast {
        width: 450px;
        min-height: 70px;
        background: white;
        border-radius: 10px;
        margin-bottom: 15px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        display: flex;
        flex-direction: column;
        position: relative;
        opacity: 1;
        animation: toastSlideIn 0.4s ease;
    }



        .custom-toast.hide {
            animation: toastSlideOut 0.4s ease forwards;
        }



    .custom-toast-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px;
    }



    .toast-message {
        font-size: 15px;
        color: #333;
        padding-right: 10px;
        word-break: break-word;
    }



    .close-btn {
        cursor: pointer;
        font-size: 20px;
        font-weight: bold;
    }



    /* Progress Line */

    .progress {
        height: 5px;
        width: 0%;
        animation: progressBar 6s linear forwards;
    }



    /* Success */

    .success {
        border-left: 6px solid #28a745;
    }

        .success .progress {
            background: #28a745;
        }



    /* Danger */

    .danger {
        border-left: 6px solid #dc3545;
    }

        .danger .progress {
            background: #dc3545;
        }



    /* Progress Animation */

    @@keyframes progressBar {

        from {
            width: 0%;
        }

        to {
            width: 100%;
        }
    }



    /* Enter Animation */

    @@keyframes toastSlideIn {

        from {
            transform: translateX(100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }



    /* Exit Animation */

    @@keyframes toastSlideOut {

        from {
            transform: translateX(0);
            opacity: 1;
        }

        to {
            transform: translateX(100%);
            opacity: 0;
        }
    }

    .normal {
        border-left: 6px solid #007bff;
    }

        .normal .progress {
            background: #007bff;
        }
</style>

<script>

    function showToast(type, message) {

        const container =
            document.getElementById("toastContainer");



        const toast =
            document.createElement("div");



        toast.classList.add("custom-toast");

        toast.classList.add(type);



        toast.innerHTML = `

                                 <div class="custom-toast-content">

                                     <div class="toast-message">

                                         ${message}

                                     </div>

                                     <div class="close-btn">

                                         &times;

                                     </div>

                                 </div>

                                 <div class="progress"></div>

                             `;



        container.appendChild(toast);



        // Auto Remove After 6 Seconds

        const autoRemove =
            setTimeout(() => {

                removeToast(toast);

            }, 6000);



        // Manual Remove

        toast.querySelector(".close-btn")
            .addEventListener("click", function () {

                clearTimeout(autoRemove);

                removeToast(toast);

            });

    }



    function removeToast(toast) {

        toast.classList.add("hide");



        setTimeout(() => {

            toast.remove();

        }, 400);

    }

</script>


@if (TempData["MsgSuccess"] != null)
{
    <script>

 showToast(
     "success",
     '@TempData.Peek("MsgSuccess")'
 );

    </script>
}



@if (TempData["MsgDanger"] != null)
{
    <script>

 showToast(
     "danger",
     '@TempData.Peek("MsgDanger")'
 );

    </script>
}

@if (TempData["MsgNormal"] != null)
{
    <script>

     showToast(
         "normal",
         '@TempData.Peek("MsgNormal")'
     );

    </script>
}