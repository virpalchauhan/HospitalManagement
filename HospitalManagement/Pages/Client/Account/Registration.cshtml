<style>
    select.form-control {
        background: transparent;
        border: none;
        border-bottom: 1px solid #ccc;
        border-radius: 0;
        color: #fff;
        box-shadow: none;
    }

        select.form-control:focus {
            outline: none;
            box-shadow: none;
            border-bottom: 1px solid #fff;
        }

        select.form-control option {
            color: #000; /* dropdown ke andar text black rahe */
        }

    select.form-control {
        appearance: auto;
        -webkit-appearance: auto;
        -moz-appearance: auto;
    }


    .custom-date {
        background: transparent;
        border: none;
        border-bottom: 1px solid #ccc;
        border-radius: 0;
        color: #fff;
    }

        .custom-date:focus {
            outline: none;
            box-shadow: none;
            border-bottom: 1px solid #fff;
        }

        /* Calendar icon white karne ke liye (Chrome based browsers) */
        .custom-date::-webkit-calendar-picker-indicator {
            filter: invert(1);
            cursor: pointer;
        }

    .custom-file {
        background: transparent;
        border: none;
        border-bottom: 1px solid #ccc;
        border-radius: 0;
        color: #fff;
    }

        .custom-file:focus {
            outline: none;
            box-shadow: none;
            border-bottom: 1px solid #fff;
        }

    .readonly-input {
        cursor: not-allowed;
        background-color: #e9ecef;
    }
</style>
<body class="tt-magic-cursor">

    <!-- Registration Form start -->
    <div class="page-contact-form">
        <div class="container">
            <div class="row section-row">
                <div class="col-lg-12">
                    <div class="section-title">
                        <h3 class="wow fadeInUp">create account</h3>
                        <h2 class="text-anime-style-3">Registration Form</h2>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-12">

                    <!-- Registration Form start -->
                    <div class="contact-us-form wow fadeInUp" data-wow-delay="0.5s">




                        <form id="registrationEmailForm" enctype="multipart/form-data" method="POST">
                            <div class="row">

                                <!-- Email -->
                                <div class="form-group  mb-4 @(Model.EmailDivClass == "col-md-12" ? "col-md-12" : "col-md-8")">

                                    <label class="mb-2" style="color:white;">
                                        Email
                                    </label>

                                    <input value="@TempData["Email"]"
                                           asp-for="SendOtpViewModel.Email"
                                           class="form-control @(Model.EmailInput == "disabled" ? "readonly-input" : "")"
                                           placeholder="Enter Email Address"
                                           readonly="@(Model.EmailInput == "disabled" ? "readonly" : null)">

                                    <span asp-validation-for="SendOtpViewModel.Email"
                                          class="text-danger"></span>

                                </div>


                                <!-- Send OTP Button -->
                                <div class="form-group col-md-4 mt-4">

                                    <div style="display:@(Model.EmailBtn == "Hide" ? "none" : "block")" class="contact-form-btn">
                                        <button asp-page-handler="SendOtp" type="submit" class="btn-default">
                                            Send OTP
                                        </button>
                                    </div>

                                </div>
                            </div>

                        </form>

                        <form id="EnterOTPForm" enctype="multipart/form-data" method="POST">
                            <div class="row">
                                <!-- Enter OTP-->
                                <div id="OtpInput" style="display:@(Model.OtpInput == "Hide" ? "none" : "flex")" ;>
                                    <div class="form-group col-md-8 mb-4">

                                        <label class="mb-2" style="color:white;">
                                            OTP
                                        </label>

                                        <input asp-for="VerifyOtpViewModel.OTP"
                                               class="form-control"
                                               placeholder="Enter OTP">

                                        <span asp-validation-for="VerifyOtpViewModel.OTP"
                                              class="text-danger"></span>

                                    </div>
                                    <input type="hidden"
                                           asp-for="VerifyOtpViewModel.Email"
                                           value="@TempData["Email"]" />

                                    <!--  OTP Verification Button -->
                                    <div class="form-group col-md-4 mt-4">

                                        <div class="contact-form-btn">
                                            <button asp-page-handler="OTPVerification" type="submit" class="btn-default">
                                                OTP Verification
                                            </button>
                                        </div>

                                    </div>

                                </div>

                        </form>
                        <form id="registrationForm" enctype="multipart/form-data" method="POST">


                            <div id="RegistrationDiv" style="display:@(Model.RegistrationDiv == "Hide" ? "none" : "block")" ;>
                                <div class="row">


                                    <input type="hidden"
                                           asp-for="RegistrationPatientViewModel.Email"
                                           value="@TempData["Email"]" />

                                    <!-- FirstName Name -->
                                    <div class="form-group col-md-6 mb-4">
                                        <label class="mb-2" style="color:white;">FirstName</label>
                                        <input class="form-control" placeholder="Enter FirstName Name" asp-for="RegistrationPatientViewModel.FirstName">
                                        <span asp-validation-for="RegistrationPatientViewModel.FirstName" class="text-danger"></span>
                                    </div>


                                    <!-- LastName Name -->
                                    <div class="form-group col-md-6 mb-4">
                                        <label class="mb-2" style="color:white;">LastName</label>
                                        <input class="form-control" placeholder="Enter LastName Name" asp-for="RegistrationPatientViewModel.LastName">
                                        <span asp-validation-for="RegistrationPatientViewModel.LastName" class="text-danger"></span>
                                    </div>


                                    <!-- Gender -->
                                    <div class="form-group col-md-6 mb-4">
                                        <label class="mb-2" style="color:white;">Gender</label>
                                        <select class="form-control custom-select" asp-for="RegistrationPatientViewModel.Gender"
                                                asp-items="Html.GetEnumSelectList<GenderType>()">
                                            <option value="">Select Gender</option>
                                        </select>
                                        <span asp-validation-for="RegistrationPatientViewModel.Gender" class="text-danger"></span>
                                    </div>


                                    <!-- Date of Birth -->
                                    <div class="form-group col-md-6 mb-4">
                                        <label class="mb-2" style="color:white;">Date Of Birth</label>
                                        <input asp-for="RegistrationPatientViewModel.DateOfBirth" type="date"
                                               class="form-control custom-date" max="@DateTime.Today.ToString("yyyy-MM-dd")">
                                        <span asp-validation-for="RegistrationPatientViewModel.DateOfBirth" class="text-danger"></span>
                                    </div>

                                    <!-- Mobile -->
                                    <div class="form-group col-md-12 mb-4">
                                        <label class="mb-2" style="color:white;">MobileNo</label>
                                        <input asp-for="RegistrationPatientViewModel.MobileNo" class="form-control"
                                               placeholder="Enter Mobile Number">
                                        <span asp-validation-for="RegistrationPatientViewModel.MobileNo" class="text-danger"></span>
                                    </div>






                                    <!-- Password -->
                                    <div class="form-group col-md-6 mb-4">
                                        <label class="mb-2" style="color:white;">password</label>
                                        <input type="password"
                                               asp-for="RegistrationPatientViewModel.PasswordHash"
                                               class="form-control"
                                               placeholder="Enter Password">
                                        <span asp-validation-for="RegistrationPatientViewModel.PasswordHash" class="text-danger"></span>
                                    </div>

                                    <!-- Confirm Password -->
                                    <div class="form-group col-md-6 mb-4">
                                        <label class="mb-2" style="color:white;">Confiram password</label>
                                        <input type="password"
                                               asp-for="RegistrationPatientViewModel.ConfirmPassword"
                                               class="form-control"
                                               placeholder="Confirm Password">
                                        <span asp-validation-for="RegistrationPatientViewModel.ConfirmPassword" class="text-danger"></span>
                                    </div>





                                    <!-- Address -->
                                    <div class="form-group col-md-6 mb-4">
                                        <label class="mb-2" style="color:white;">Address</label>

                                        <input type="text"
                                               asp-for="RegistrationPatientViewModel.Address"
                                               class="form-control"
                                               placeholder="Enter Address">

                                        <span asp-validation-for="RegistrationPatientViewModel.Address"
                                              class="text-danger"></span>
                                    </div>

                                    <!-- City -->
                                    <div class="form-group col-md-6 mb-4">
                                        <label class="mb-2" style="color:white;">City</label>

                                        <input type="text"
                                               asp-for="RegistrationPatientViewModel.City"
                                               class="form-control"
                                               placeholder="Enter City">

                                        <span asp-validation-for="RegistrationPatientViewModel.City"
                                              class="text-danger"></span>
                                    </div>

                                    <!-- State Name -->
                                    <div class="form-group col-md-6 mb-4">
                                        <label class="mb-2" style="color:white;">State Name</label>

                                        <input type="text"
                                               asp-for="RegistrationPatientViewModel.StateName"
                                               class="form-control"
                                               placeholder="Enter State Name">

                                        <span asp-validation-for="RegistrationPatientViewModel.StateName"
                                              class="text-danger"></span>
                                    </div>

                                    <!-- Pincode -->
                                    <div class="form-group col-md-6 mb-4">
                                        <label class="mb-2" style="color:white;">Pincode</label>

                                        <input type="text"
                                               asp-for="RegistrationPatientViewModel.Pincode"
                                               class="form-control"
                                               placeholder="Enter Pincode">

                                        <span asp-validation-for="RegistrationPatientViewModel.Pincode"
                                              class="text-danger"></span>
                                    </div>

                                    <!-- Blood Group -->
                                    <div class="form-group col-md-6 mb-4">

                                        <label class="mb-2" style="color:white;">Blood Group</label>

                                        <select class="form-control"
                                                asp-for="RegistrationPatientViewModel.BloodGroup"
                                                asp-items="Html.GetEnumSelectList<BloodGroupType>()">

                                            <option value="">Select Blood Group</option>

                                        </select>

                                        <span asp-validation-for="RegistrationPatientViewModel.BloodGroup"
                                              class="text-danger"></span>

                                    </div>

                                    <!-- Profile Picure -->
                                    <div class="form-group col-md-6 mb-4">

                                        <label class="mb-2" style="color:white;">Profile Picure</label>

                                        <input asp-for="RegistrationPatientViewModel.ProfilePhoto" class="form-control custom-file" required>
                                        <span asp-validation-for="RegistrationPatientViewModel.ProfilePhoto" class="text-danger"></span>

                                    </div>

                                    <!-- Register Button -->
                                    <div class="col-lg-12">
                                        <div class="contact-form-btn">
                                            <button asp-page-handler="RegisterBtn" style="cursor:not-allowed;" type="submit" class="btn-default">
                                                Register Now
                                            </button>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="text-center mt-3">

                                <span style="color:white;">
                                    Already have an account?
                                </span>

                                <a asp-page="/Login"
                                   class="text-info font-weight-bold">

                                    Login Here

                                </a>

                            </div>

                        </form>
                    </div>

                    <!-- Registration Form end -->

                </div>
            </div>
        </div>
    </div>


    <!-- Toast Container -->

    <div class="custom-toast-container"
         id="toastContainer">
    </div>



    <style>

        .custom-toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 999999;
        }



        .custom-toast {
            width: 450px;
            min-height: 70px;
            background: white;
            border-radius: 10px;
            margin-bottom: 15px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            display: flex;
            flex-direction: column;
            position: relative;
            opacity: 1;
            animation: toastSlideIn 0.4s ease;
        }



            .custom-toast.hide {
                animation: toastSlideOut 0.4s ease forwards;
            }



        .custom-toast-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
        }



        .toast-message {
            font-size: 15px;
            color: #333;
            padding-right: 10px;
            word-break: break-word;
        }



        .close-btn {
            cursor: pointer;
            font-size: 20px;
            font-weight: bold;
        }



        /* Progress Line */

        .progress {
            height: 5px;
            width: 0%;
            animation: progressBar 6s linear forwards;
        }



        /* Success */

        .success {
            border-left: 6px solid #28a745;
        }

            .success .progress {
                background: #28a745;
            }



        /* Danger */

        .danger {
            border-left: 6px solid #dc3545;
        }

            .danger .progress {
                background: #dc3545;
            }



        /* Progress Animation */

        @@keyframes progressBar {

            from {
                width: 0%;
            }

            to {
                width: 100%;
            }
        }



        /* Enter Animation */

        @@keyframes toastSlideIn {

            from {
                transform: translateX(100%);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }



        /* Exit Animation */

        @@keyframes toastSlideOut {

            from {
                transform: translateX(0);
                opacity: 1;
            }

            to {
                transform: translateX(100%);
                opacity: 0;
            }
        }

        .normal {
            border-left: 6px solid #007bff;
        }

            .normal .progress {
                background: #007bff;
            }
    </style>

    <script>

        function showToast(type, message) {

            const container =
                document.getElementById("toastContainer");



            const toast =
                document.createElement("div");



            toast.classList.add("custom-toast");

            toast.classList.add(type);



            toast.innerHTML = `

                                    <div class="custom-toast-content">

                                        <div class="toast-message">

                                            ${message}

                                        </div>

                                        <div class="close-btn">

                                            &times;

                                        </div>

                                    </div>

                                    <div class="progress"></div>

                                `;



            container.appendChild(toast);



            // Auto Remove After 6 Seconds

            const autoRemove =
                setTimeout(() => {

                    removeToast(toast);

                }, 6000);



            // Manual Remove

            toast.querySelector(".close-btn")
                .addEventListener("click", function () {

                    clearTimeout(autoRemove);

                    removeToast(toast);

                });

        }



        function removeToast(toast) {

            toast.classList.add("hide");



            setTimeout(() => {

                toast.remove();

            }, 400);

        }

    </script>


    @if (TempData["MsgSuccess"] != null)
    {
        <script>

    showToast(
        "success",
        '@TempData.Peek("MsgSuccess")'
    );

        </script>
    }



    @if (TempData["MsgDanger"] != null)
    {
        <script>

    showToast(
        "danger",
        '@TempData.Peek("MsgDanger")'
    );

        </script>
    }

    @if (TempData["MsgNormal"] != null)
    {
        <script>

        showToast(
            "normal",
            '@TempData.Peek("MsgNormal")'
        );

        </script>
    }




