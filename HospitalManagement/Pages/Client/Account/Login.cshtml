        }
</style>
<body class="tt-magic-cursor">

    <!-- Login Form start -->
    <div class="page-contact-form">

        <div class="container">

            <div class="row section-row">

                <div class="col-lg-12">

                    <div class="section-title">

                        <h3 class="wow fadeInUp">welcome back</h3>

                        <h2 class="text-anime-style-3">
                            Login Form
                        </h2>

                    </div>

                </div>

            </div>

            <div class="row">

                <div class="col-lg-12">

                    <div class="contact-us-form wow fadeInUp"
                         data-wow-delay="0.5s">

                        <form id="loginForm"
                              method="post">

                            <div class="row">

                                <!-- Email -->
                                <div class="form-group col-md-12 mb-4">

                                    <label class="mb-2"
                                           style="color:white;">

                                        Email

                                    </label>

                                    <input asp-for="LoginViewModel.Email"
                                           class="form-control"
                                           placeholder="Enter Email Address">

                                    <span asp-validation-for="LoginViewModel.Email"
                                          class="text-danger"></span>

                                </div>


                                <!-- Password -->
                                <div class="form-group col-md-12 mb-4">

                                    <label class="mb-2"
                                           style="color:white;">

                                        Password

                                    </label>

                                    <div class="form-control">

                                        <input type="password"
                                               asp-for="LoginViewModel.PasswordHash"
                                               class="form-control"
                                               id="password"
                                               placeholder="Enter Password">



                                    </div>

                                    <span asp-validation-for="LoginViewModel.PasswordHash"
                                          class="text-danger"></span>

                                </div>


                                <!-- Login Button -->
                                <div class="col-lg-12">

                                    <div class="contact-form-btn">

                                        <button type="submit"
                                                class="btn-default">

                                            Login Now

                                        </button>

                                    </div>

                                </div>


                                <!-- Registration Link -->
                                <div class="text-center mt-3">

                                    <span style="color:white;">

                                        Don't have an account?

                                    </span>

                                    <a asp-page="/Client/Account/Registration"
                                       class="text-info font-weight-bold">

                                        Register Here

                                    </a>

                                </div>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- Toast Container -->

    <div class="custom-toast-container"
         id="toastContainer">
    </div>



    <style>

        .custom-toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 999999;
        }



        .custom-toast {
            width: 450px;
            min-height: 70px;
            background: white;
            border-radius: 10px;
            margin-bottom: 15px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            display: flex;
            flex-direction: column;
            position: relative;
            opacity: 1;
            animation: toastSlideIn 0.4s ease;
        }



            .custom-toast.hide {
                animation: toastSlideOut 0.4s ease forwards;
            }



        .custom-toast-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
        }



        .toast-message {
            font-size: 15px;
            color: #333;
            padding-right: 10px;
            word-break: break-word;
        }



        .close-btn {
            cursor: pointer;
            font-size: 20px;
            font-weight: bold;
        }



        /* Progress Line */

        .progress {
            height: 5px;
            width: 0%;
            animation: progressBar 6s linear forwards;
        }



        /* Success */

        .success {
            border-left: 6px solid #28a745;
        }

            .success .progress {
                background: #28a745;
            }



        /* Danger */

        .danger {
            border-left: 6px solid #dc3545;
        }

            .danger .progress {
                background: #dc3545;
            }



        /* Progress Animation */

        @@keyframes progressBar {

            from {
                width: 0%;
            }

            to {
                width: 100%;
            }
        }



        /* Enter Animation */

        @@keyframes toastSlideIn {

            from {
                transform: translateX(100%);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }



        /* Exit Animation */

        @@keyframes toastSlideOut {

            from {
                transform: translateX(0);
                opacity: 1;
            }

            to {
                transform: translateX(100%);
                opacity: 0;
            }
        }

        .normal {
            border-left: 6px solid #007bff;
        }

            .normal .progress {
                background: #007bff;
            }
    </style>

    <script>

        function showToast(type, message) {

            const container =
                document.getElementById("toastContainer");



            const toast =
                document.createElement("div");



            toast.classList.add("custom-toast");

            toast.classList.add(type);



            toast.innerHTML = `

                                    <div class="custom-toast-content">

                                        <div class="toast-message">

                                            ${message}

                                        </div>

                                        <div class="close-btn">

                                            &times;

                                        </div>

                                    </div>

                                    <div class="progress"></div>

                                `;



            container.appendChild(toast);



            // Auto Remove After 6 Seconds

            const autoRemove =
                setTimeout(() => {

                    removeToast(toast);

                }, 6000);



            // Manual Remove

            toast.querySelector(".close-btn")
                .addEventListener("click", function () {

                    clearTimeout(autoRemove);

                    removeToast(toast);

                });

        }



        function removeToast(toast) {

            toast.classList.add("hide");



            setTimeout(() => {

                toast.remove();

            }, 400);

        }

    </script>


    @if (TempData["MsgSuccess"] != null)
    {
        <script>

    showToast(
        "success",
        '@TempData.Peek("MsgSuccess")'
    );

        </script>
    }



    @if (TempData["MsgDanger"] != null)
    {
        <script>

    showToast(
        "danger",
        '@TempData.Peek("MsgDanger")'
    );

        </script>
    }

    @if (TempData["MsgNormal"] != null)
    {
        <script>

        showToast(
            "normal",
            '@TempData.Peek("MsgNormal")'
        );

        </script>
    }



