@page
@model HospitalManagement.Pages.Admin.Leave.AllLeaveRequestsModel
@using HospitalManagement.Entity.Model.Enums
@{

    Layout = "/Pages/Admin/_AdminLayout.cshtml";
    int count = 1;

}

<div class="card">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h2 class="mb-0">
            All Leave Requests
        </h2>

        <div style="min-width:250px;">

            <label class="form-label mb-1">Status</label>

            <select id="Status" name="Status" class="form-select">

                <option value="">All</option>

                @foreach (var status in Enum.GetValues<LeaveStatusType>())
                {
                    <option value="@((byte)status)">
                        @status
                    </option>
                }

            </select>

        </div>

    </div>


    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover table-centered">

                <thead class="table-light">

                    <tr>
                        <th scope="col">No</th>
                        <th scope="col">Employee Type</th>
                        <th scope="col">Leave Type</th>
                        <th scope="col">From Date</th>
                        <th scope="col">To Date</th>
                        <th scope="col">Status</th>
                        <th scope="col">View</th>
                        <th scope="col">Request Date</th>
                    </tr>

                </thead>

                <tbody id="LeaveTableBody">

                    @foreach (var item in Model.LeaveRequestsList)
                    {
                        <tr>

                            <td>
                                @count
                            </td>

                            <td>
                                @if (item.EmployeeType ==
                                   DoctorNurseApplicationsRollType.Doctor)
                                {
                                    <span>Doctor</span>
                                }
                                else if (item.EmployeeType ==
                                    DoctorNurseApplicationsRollType.Nurse)
                                {
                                    <span>Nurse</span>
                                }
                            </td>

                            <td>
                                @item.LeaveType
                            </td>

                            <td>
                                @item.FromDate.Value.ToString("dd-MM-yyyy")
                            </td>

                            <td>
                                @item.ToDate.Value.ToString("dd-MM-yyyy")
                            </td>

                            <td>
                                @if (item.Status == LeaveStatusType.Pending)
                                {
                                    <span class="badge bg-warning">
                                        Pending
                                    </span>
                                }
                                else if (item.Status == LeaveStatusType.Approved)
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else if (item.Status == LeaveStatusType.Rejected)
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                            </td>

                            <td>

                                <a asp-page="/Admin/Leave/ViewSingleLeaveAdmin"
                                   asp-route-LeaveRequestId="@item.LeaveRequestId"
                                   class="btn btn-success btn-sm w-100">
                                    View
                                </a>

                            </td>

                            <td>
                                @item.CreatedAt.ToString("dd-MM-yyyy")
                            </td>

                        </tr>

                        count++;
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


@if (TempData["Msg"] != null)
{
    <script>
        alert("@TempData["Msg"]");
    </script>
}


<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>


<script>

    $(document).ready(function () {

        $("#Status").change(function () {

            var status = $(this).val();

            $.ajax({

                url: "/Admin/Leave/AllLeaveRequests?handler=Status",

                type: "GET",

                data: {
                    status: status
                },

                success: function (response) {

                    var html = "";

                    var count = 1;

                    $.each(response, function (index, item) {

                        html += "<tr>";

                        // No
                        html += "<td>" + count + "</td>";


                        // Employee Type
                        var employeeTypeText = "";

                        if (item.employeeType == 1) {
                            employeeTypeText = "Doctor";
                        }
                        else if (item.employeeType == 2) {
                            employeeTypeText = "Nurse";
                        }

                        html += "<td>" + employeeTypeText + "</td>";


                        // Leave Type
                        var leaveTypeText = "";

                        switch (item.leaveType) {

                            case 1:
                                leaveTypeText = "CasualLeave";
                                break;

                            case 2:
                                leaveTypeText = "SickLeave";
                                break;

                            case 3:
                                leaveTypeText = "EmergencyLeave";
                                break;

                            case 4:
                                leaveTypeText = "PaidLeave";
                                break;

                            case 5:
                                leaveTypeText = "UnpaidLeave";
                                break;
                        }

                        html += "<td>" + leaveTypeText + "</td>";


                        // From Date
                        html += "<td>" + item.fromDate + "</td>";


                        // To Date
                        html += "<td>" + item.toDate + "</td>";


                        // Status
                        var statusText = "";
                        var statusClass = "";

                        switch (item.status) {

                            case 1:
                                statusText = "Pending";
                                statusClass = "bg-warning";
                                break;

                            case 2:
                                statusText = "Approved";
                                statusClass = "bg-success";
                                break;

                            case 3:
                                statusText = "Rejected";
                                statusClass = "bg-danger";
                                break;
                        }

                        html += '<td><span class="badge ' +
                            statusClass +
                            '">' +
                            statusText +
                            '</span></td>';


                        // View
                        html += "<td>";

                        html += '<a href="/Admin/Leave/ViewSingleLeaveAdmin?LeaveRequestId='
                            + item.leaveRequestId +
                            '" class="btn btn-success btn-sm w-100">View</a>';

                        html += "</td>";


                        // Request Date
                        html += "<td>" + item.createdAt + "</td>";

                        html += "</tr>";

                        count++;

                    });

                    $("#LeaveTableBody").html(html);

                },

                error: function (xhr) {

                    console.log(xhr);

                }

            });

        });

    });

</script>