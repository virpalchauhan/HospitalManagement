@page
@model HospitalManagement.Pages.Admin.Leave.MyLeaveRequestsModel
@using HospitalManagement.Entity.Model.Enums
@{

    Layout = "/Pages/Admin/_AdminLayout.cshtml";
    int count = 1;

}

<div class="card">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h2 class="mb-0">
            My Leave Requests
        </h2>

        <!-- Status Dropdown -->
        <div style="min-width:250px;">

            <label class="form-label mb-1">
                Status
            </label>

            <select id="Status"
                    name="Status"
                    class="form-select">

                <option value="">All</option>

                @foreach (var status in Enum.GetValues<LeaveStatusType>())
                {
                    <option value="@((byte)status)">
                        @status
                    </option>
                }

            </select>

        </div>

    </div>


    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover table-centered">

                <thead class="table-light">

                    <tr>
                        <th scope="col">No</th>
                        <th scope="col">Leave Type</th>
                        <th scope="col">From Date</th>
                        <th scope="col">To Date</th>
                        <th scope="col">Status</th>
                        <th scope="col">Request Date</th>
                        <th scope="col">View</th>
                    </tr>

                </thead>


                <tbody id="LeaveTableBody">

                    @foreach (var item in Model.LeaveRequestsList)
                    {
                        <tr>

                            <!-- No -->
                            <td>
                                @count
                            </td>


                            <!-- Leave Type -->
                            <td>
                                @item.LeaveType
                            </td>


                            <!-- From Date -->
                            <td>
                                @item.FromDate.Value.ToString("dd-MM-yyyy")
                            </td>


                            <!-- To Date -->
                            <td>
                                @item.ToDate.Value.ToString("dd-MM-yyyy")
                            </td>


                            <!-- Status -->
                            <td>

                                @if (item.Status == LeaveStatusType.Pending)
                                {
                                    <span class="badge bg-warning">
                                        Pending
                                    </span>
                                }
                                else if (item.Status == LeaveStatusType.Approved)
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else if (item.Status == LeaveStatusType.Rejected)
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }

                            </td>


                            <!-- Request Date -->
                            <td>
                                @item.CreatedAt.ToString("dd-MM-yyyy")
                            </td>


                            <!-- View -->
                            <td>

                                <a asp-page="/Admin/Leave/ViewLeave"
                                   asp-route-LeaveRequestId="@item.LeaveRequestId"
                                   class="btn btn-primary btn-sm w-100">

                                    View Leave

                                </a>

                            </td>

                        </tr>

                        count++;
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


@if (TempData["Msg"] != null)
{
    <script>
        alert("@TempData["Msg"]");
    </script>
}


<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


<script>

    $(document).ready(function () {

        $("#Status").change(function () {

            var status = $(this).val();

            $.ajax({

                url: "/Admin/Leave/MyLeaveRequests?handler=Status",

                type: "GET",

                data: {
                    status: status
                },

                success: function (response) {

                    var html = "";

                    var count = 1;


                    $.each(response, function (index, item) {

                        html += "<tr>";


                        // No
                        html += "<td>" + count + "</td>";


                        // Leave Type
                        var leaveTypeText = "";

                        switch (item.leaveType) {

                            case 1:
                                leaveTypeText = "Casual Leave";
                                break;

                            case 2:
                                leaveTypeText = "Sick Leave";
                                break;

                            case 3:
                                leaveTypeText = "Emergency Leave";
                                break;

                            case 4:
                                leaveTypeText = "Paid Leave";
                                break;

                            case 5:
                                leaveTypeText = "Unpaid Leave";
                                break;

                        }

                        html += "<td>" + leaveTypeText + "</td>";


                        // From Date
                        html += "<td>" + item.fromDate + "</td>";


                        // To Date
                        html += "<td>" + item.toDate + "</td>";


                        // Status
                        var statusText = "";
                        var statusClass = "";

                        switch (item.status) {

                            case 1:
                                statusText = "Pending";
                                statusClass = "bg-warning";
                                break;

                            case 2:
                                statusText = "Approved";
                                statusClass = "bg-success";
                                break;

                            case 3:
                                statusText = "Rejected";
                                statusClass = "bg-danger";
                                break;

                        }

                        html += '<td><span class="badge '
                            + statusClass
                            + '">'
                            + statusText
                            + '</span></td>';


                        // Request Date
                        html += "<td>" + item.createdAt + "</td>";


                        // View
                        html += "<td>";

                        html += '<a href="/Admin/Leave/ViewLeave?LeaveRequestId='
                            + item.leaveRequestId
                            + '" class="btn btn-primary btn-sm w-100">'
                            + 'View Leave'
                            + '</a>';

                        html += "</td>";


                        html += "</tr>";

                        count++;

                    });


                    $("#LeaveTableBody").html(html);

                },


                error: function (xhr) {

                    console.log(xhr);

                }

            });

        });

    });

</script>