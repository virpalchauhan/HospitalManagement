@page
@model HospitalManagement.Pages.Admin.Account.ChangePasswordModel
@{
    Layout = "/Pages/Admin/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-lg-12">

        <div class="card">

            <div class="card-header">
                <h2 class="mb-0">Change Password</h2>
            </div>

            <div class="card-body">

                <form method="post">

                    <div class="row">

                        <!-- Current Password -->
                        <div class="col-md-12 mb-3">

                            <label class="form-label">
                                Current Password
                            </label>

                            <input asp-for="ChangePasswordViewModel.CurrentPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter Current Password">

                            <span asp-validation-for="ChangePasswordViewModel.CurrentPassword"
                                  class="text-danger"></span>

                        </div>

                        <!-- New Password -->
                        <div class="col-md-12 mb-3">

                            <label class="form-label">
                                New Password
                            </label>

                            <input asp-for="ChangePasswordViewModel.NewPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter New Password">

                            <span asp-validation-for="ChangePasswordViewModel.NewPassword"
                                  class="text-danger"></span>

                        </div>

                        <!-- Confirm Password -->
                        <div class="col-md-12 mb-3">

                            <label class="form-label">
                                Confirm Password
                            </label>

                            <input asp-for="ChangePasswordViewModel.ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter Confirm Password">

                            <span asp-validation-for="ChangePasswordViewModel.ConfirmPassword"
                                  class="text-danger"></span>

                        </div>

                        <!-- Button -->
                        <div class="col-md-12">

                            <button type="submit"
                                    class="btn btn-primary rounded-pill">

                                <iconify-icon icon="solar:key-outline"
                                              class="align-middle me-1 fs-18">
                                </iconify-icon>

                                Change Password

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

@if (TempData["Msg"] != null)
{
    <script>
        alert("@TempData["Msg"]");
    </script>
}