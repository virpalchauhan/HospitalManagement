@page
@model HospitalManagement.Pages.Admin.Account.LoginModel
@{


    Layout = null;

}
<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Title Meta -->
    <meta charset="utf-8" />
    <title>Sign In | Darkone - Dark Admin & UI Kit Template</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Darkone: An advanced, fully responsive admin dashboard template packed with features to streamline your analytics and management needs." />
    <meta name="author" content="StackBros" />
    <meta name="keywords" content="Darkone, admin dashboard, responsive template, analytics, modern UI, management tools" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ffffff">

    <!-- App favicon -->
    <link rel="shortcut icon" href="assets/images/favicon.ico">

    <!-- Google Font Family link -->
    <link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Play:wght@400;700&amp;display=swap" rel="stylesheet">

    <!-- Vendor css -->
    <link href="/Admin/assets/css/vendor.min.css" rel="stylesheet" type="text/css" />

    <!-- Icons css -->
    <link href="/Admin/assets/css/icons.min.css" rel="stylesheet" type="text/css" />

    <!-- App css -->
    <link href="/Admin/assets/css/style.min.css" rel="stylesheet" type="text/css" />

    <!-- Theme Config js -->
    <script src="/Admin/assets/js/config.js"></script>

</head>

<body class="authentication-bg">

    <div class="account-pages py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-6 col-lg-5">
                    <div class="card border-0 shadow-lg">
                        <div class="card-body p-5">
                            <div class="text-center">
                                <div class="mx-auto mb-4 text-center auth-logo">
                                    <a href="index.html" class="logo-dark">
                                        <img src="/Admin/assets/images/logo-dark.png" height="32" alt="logo dark">
                                    </a>

                                    <a href="index.html" class="logo-light">
                                        <img src="/Admin/assets/images/logo-light.png" height="28" alt="logo light">
                                    </a>
                                </div>
                                <h4 class="fw-bold text-dark mb-2">
                                    Welcome Back!</h3>
                                    <p class="text-muted">Sign in to your account to continue</p>
                            </div>
                            <form method="post" class="mt-4">
                                <div class="mb-3">
                                    <label for="email" class="form-label">Email Address</label>
                                    <input asp-for="LoginViewModel.Email" class="form-control" placeholder="Enter your email">
                                    <span asp-validation-for="LoginViewModel.Email" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <label for="password" class="form-label">Password</label>
                                        <a href="/Admin/Account/ForgotPassword" class="text-decoration-none small text-muted">Forgot password?</a>
                                    </div>
                                    <input asp-for="LoginViewModel.PasswordHash" type="password" class="form-control" id="password" placeholder="Enter your password">
                                    <span asp-validation-for="LoginViewModel.PasswordHash" class="text-danger"></span>
                                </div>


                                <div class="d-grid">
                                    <button class="btn btn-dark btn-lg fw-medium" type="submit">Sign In</button>
                                </div>
                            </form>
                        </div>
                    </div>
                    @*<p class="text-center mt-4 text-white text-opacity-50">
                            Don't have an account?
                            <a href="auth-signup.html" class="text-decoration-none text-white fw-bold">Sign Up</a>
                        </p>*@
                </div>
            </div>
        </div>
    </div>
    <!--JQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>


    <!-- Validation -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <!-- Vendor Javascript -->
    <script src="/Admin/assets/js/vendor.min.js"></script>

    <!-- App Javascript -->
    <script src="/Admin/assets/js/app.js"></script>








    <!-- Toast Container -->

    <div class="custom-toast-container"
         id="toastContainer">
    </div>



    <style>

        .custom-toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 999999;
        }



        .custom-toast {
            width: 450px;
            min-height: 70px;
            background: white;
            border-radius: 10px;
            margin-bottom: 15px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            display: flex;
            flex-direction: column;
            position: relative;
            opacity: 1;
            animation: toastSlideIn 0.4s ease;
        }



            .custom-toast.hide {
                animation: toastSlideOut 0.4s ease forwards;
            }



        .custom-toast-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
        }



        .toast-message {
            font-size: 15px;
            color: #333;
            padding-right: 10px;
            word-break: break-word;
        }



        .close-btn {
            cursor: pointer;
            font-size: 20px;
            font-weight: bold;
        }



        /* Progress Line */

        .progress {
            height: 5px;
            width: 0%;
            animation: progressBar 6s linear forwards;
        }



        /* Success */

        .success {
            border-left: 6px solid #28a745;
        }

            .success .progress {
                background: #28a745;
            }



        /* Danger */

        .danger {
            border-left: 6px solid #dc3545;
        }

            .danger .progress {
                background: #dc3545;
            }



        /* Progress Animation */

        @@keyframes progressBar {

            from {
                width: 0%;
            }

            to {
                width: 100%;
            }
        }



        /* Enter Animation */

        @@keyframes toastSlideIn {

            from {
                transform: translateX(100%);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }



        /* Exit Animation */

        @@keyframes toastSlideOut {

            from {
                transform: translateX(0);
                opacity: 1;
            }

            to {
                transform: translateX(100%);
                opacity: 0;
            }
        }

        .normal {
            border-left: 6px solid #007bff;
        }

            .normal .progress {
                background: #007bff;
            }
    </style>

    <script>

        function showToast(type, message) {

            const container =
                document.getElementById("toastContainer");



            const toast =
                document.createElement("div");



            toast.classList.add("custom-toast");

            toast.classList.add(type);



            toast.innerHTML = `

                                    <div class="custom-toast-content">

                                        <div class="toast-message">

                                            ${message}

                                        </div>

                                        <div class="close-btn">

                                            &times;

                                        </div>

                                    </div>

                                    <div class="progress"></div>

                                `;



            container.appendChild(toast);



            // Auto Remove After 6 Seconds

            const autoRemove =
                setTimeout(() => {

                    removeToast(toast);

                }, 6000);



            // Manual Remove

            toast.querySelector(".close-btn")
                .addEventListener("click", function () {

                    clearTimeout(autoRemove);

                    removeToast(toast);

                });

        }



        function removeToast(toast) {

            toast.classList.add("hide");



            setTimeout(() => {

                toast.remove();

            }, 400);

        }

    </script>


    @if (TempData["MsgSuccess"] != null)
    {
        <script>

    showToast(
        "success",
        '@TempData.Peek("MsgSuccess")'
    );

        </script>
    }



    @if (TempData["MsgDanger"] != null)
    {
        <script>

    showToast(
        "danger",
        '@TempData.Peek("MsgDanger")'
    );

        </script>
    }

    @if (TempData["MsgNormal"] != null)
    {
        <script>

        showToast(
            "normal",
            '@TempData.Peek("MsgNormal")'
        );

        </script>
    }
</body>


