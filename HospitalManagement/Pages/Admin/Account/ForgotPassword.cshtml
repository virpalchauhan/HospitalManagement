@page
@model HospitalManagement.Pages.Admin.Account.ForgotPasswordModel
@{


    Layout = null;

}
<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Title Meta -->
    <meta charset="utf-8" />
    <title>Sign In | Darkone - Dark Admin & UI Kit Template</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Darkone: An advanced, fully responsive admin dashboard template packed with features to streamline your analytics and management needs." />
    <meta name="author" content="StackBros" />
    <meta name="keywords" content="Darkone, admin dashboard, responsive template, analytics, modern UI, management tools" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ffffff">

    <!-- App favicon -->
    <link rel="shortcut icon" href="assets/images/favicon.ico">

    <!-- Google Font Family link -->
    <link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Play:wght@400;700&amp;display=swap" rel="stylesheet">

    <!-- Vendor css -->
    <link href="/Admin/assets/css/vendor.min.css" rel="stylesheet" type="text/css" />

    <!-- Icons css -->
    <link href="/Admin/assets/css/icons.min.css" rel="stylesheet" type="text/css" />

    <!-- App css -->
    <link href="/Admin/assets/css/style.min.css" rel="stylesheet" type="text/css" />

    <!-- Theme Config js -->
    <script src="/Admin/assets/js/config.js"></script>

</head>
<style>
button:hover {
        opacity: 0.9;
    }
</style>
<body class="authentication-bg">
    <form  style="display:@(Model.CurrentStep == "Email" ? "block" : "none")" id="PasswordReset" method="post">
        <div class="account-pages py-5">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-md-6 col-lg-5">
                        <div class="card border-0 shadow-lg">
                            <div class="card-body p-5">
                                <div class="text-center">
                                    <div class="mx-auto mb-4 text-center auth-logo">
                                        <a href="index.html" class="logo-dark">
                                            <img src="/Admin/assets/images/logo-dark.png" height="32" alt="logo dark">
                                        </a>
                                        <a href="index.html" class="logo-light">
                                            <img src="/Admin/assets/images/logo-light.png" height="28" alt="logo light">
                                        </a>
                                    </div>
                                    <h4 class="fw-bold text-dark mb-2">Forgot Password?</h4>
                                    <p class="text-muted">Enter your email, we will send OTP in your Mail</p>
                                </div>

                                <form method="post" class="mt-4">
                                    <div class="mb-3">
                                        <label for="email" class="form-label">Email Address</label>
                                        <input asp-for="ForgotPasswordViewModel.Email"
                                               class="form-control"
                                               placeholder="Enter your email">
                                        <span asp-validation-for="ForgotPasswordViewModel.Email"
                                              class="text-danger"></span>
                                    </div>

                                    <div class="d-grid">
                                        <button class="btn btn-dark btn-lg fw-medium" type="submit" asp-page-handler="SendOtp">
                                            Send OTP
                                        </button>
                                    </div>
                                </form>

                                <div class="text-center mt-4">
                                    <p class="text-muted mb-0">
                                        Remember your password?
                                        <a href="/Admin/Account/Login" class="text-dark fw-medium">Sign In</a>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>


    <form style="display:@(Model.CurrentStep == "Otp" ? "block" : "none")" method="post" class="mt-4">
        <div id="EnterOtp">
            <div class="account-pages py-5">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-md-6 col-lg-5">
                            <div class="card border-0 shadow-lg">
                                <div class="card-body p-5 text-center">

                                    <h4 class="fw-bold text-dark mb-2">Verify OTP</h4>
                                    <p class="text-muted">Enter the 6-digit OTP</p>

                                    <!-- OTP Input -->
                                    <div class="mb-3 mt-4">
                                        <input asp-for="OtpViewModel.Otp" type="text" id="otp"
                                               inputmode="numeric"
                                               maxlength="6"
                                               oninput="handleOTP(this)"
                                               onkeydown="return blockInvalidKeys(event)"
                                               class="form-control text-center"
                                               style="font-size:20px; letter-spacing:6px;">
                                        <span asp-validation-for="OtpViewModel.Otp"
                                              class="text-danger"></span>
                                    </div>

                                    <!-- Button -->
                                    <div class="d-grid">
                                        <button id="verifyBtn" class="btn btn-dark btn-lg fw-medium position-relative" asp-page-handler="VerifyOtp">

                                            <span id="btnText">Verify OTP</span>

                                            <!-- Loader -->
                                            <span id="loader"
                                                  style="display:none; width:20px; height:20px;
                                          border:3px solid #fff;
                                          border-top:3px solid transparent;
                                          border-radius:50%;
                                          position:absolute;
                                          top:50%; left:50%;
                                          transform:translate(-50%, -50%);
                                          animation:spin 1s linear infinite;">
                                            </span>

                                        </button>
                                    </div>

                                    <p id="message" class="mt-3"></p>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </form>


    <form style="display:@(Model.CurrentStep == "Reset" ? "block" : "none")" method="post" class="mt-4">
        <div id="ResetPassword">
            <div class="account-pages py-5">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-md-6 col-lg-5">
                            <div class="card border-0 shadow-lg">
                                <div class="card-body p-5 text-center">

                                    <h4 class="fw-bold text-dark mb-2">Reset Password</h4>
                                    <p class="text-muted">Enter your new password</p>

                                    <!-- New Password -->
                                    <div class="mb-3 mt-4 text-start">
                                        <label class="form-label">New Password</label>
                                        <input  asp-for="ForgotNewPassword.PasswordHash"
                                               type="password"
                                               class="form-control"
                                               id="password"
                                               placeholder="Enter your password">
                                        <span asp-validation-for="ForgotNewPassword.PasswordHash"
                                              class="text-danger"></span>
                                    </div>

                                    <!-- Confirm Password -->
                                    <div class="mb-3 text-start">
                                        <label class="form-label">Confirm Password</label>
                                        <input  asp-for="ForgotNewPassword.ConfirmPassword"
                                               type="password"
                                               class="form-control"
                                               id="confirmPassword"
                                               placeholder="Confirm your password">
                                        <span asp-validation-for="ForgotNewPassword.ConfirmPassword"
                                              class="text-danger"></span>
                                    </div>

                                    <!-- Button -->
                                    <div class="d-grid">
                                        <button class="btn btn-dark btn-lg fw-medium"
                                                asp-page-handler="ResetPassword">
                                            Update Password
                                        </button>
                                    </div>

                                    <p id="resetMessage" class="mt-3"></p>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="/Admin/assets/js/vendor.min.js"></script>
    <script src="/Admin/assets/js/app.js"></script>


    @if (TempData["Msg"] != null)
    {
        <script>
        alert("@TempData["Msg"]");

        </script>

    }


</body>


