@page
@model HospitalManagement.Pages.Admin.Appointment.AllAppointmentModel
@using HospitalManagement.Entity.Model.Enums;
@{

    Layout = "/Pages/Admin/_AdminLayout.cshtml";
    int count = 1;

}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">

        <h2 class="mb-0">
            List Appointment
        </h2>

        <div style="min-width:250px;">
            <label class="form-label mb-1">Status</label>

            <select id="Status" name="Status" class="form-select">
                <option value="">All</option>
                @foreach (var status in Enum.GetValues<AppointmentStatusType>())
                {
                    <option value="@((byte)status)">@status</option>
                }
            </select>
        </div>

    </div>

    <div class="card-body">

        <div class="table-responsive">
            <table class="table table-hover table-centered">
                <thead class="table-light">
                    <tr>
                        <th scope="col">No</th>
                        <th scope="col">Patient Name</th>
                        <th scope="col">Department Name</th>
                        <th scope="col">Status</th>
                        <th scope="col">View</th>

                        <th scope="col">Request Date</th>
                    </tr>
                </thead>
                <tbody id="AppointmentTableBody">
                    @foreach (var item in Model.GetAllAppointmentsforDoctorList)
                    {
                        <tr>
                            <td>@count</td>
                            <td>@item.PatientName</td>
                            <td>@item.DepartmentName</td>
                            <td>@item.Status</td>

                            <td>
                                <a asp-page="/Admin/Appointment/SingleAppointment"
                                   asp-route-AppointmentId="@item.AppointmentId"
                                   class="btn btn-success btn-sm w-100">
                                    View
                                </a>
                            </td>

                            <td>@item.AppointmentBookDate</td>
                        </tr>

                        count++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@if (TempData["Msg"] != null)
{
    <script>
        alert("@TempData["Msg"]");

    </script>
}

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script>
<!-- Your Custom Script-- >
            $(document).ready(function () {

                $("#Status").change(function () {

                    var status = $(this).val();

                    $.ajax({

                        url: "/Admin/Appointment/AllAppointment?handler=Status",

                        type: "GET",

                        data: {
                            status: status
                        },

                        success: function (response) {
                            debugger;
                            var html = "";

                            var count = 1;

                            $.each(response, function (index, item) {

                                html += "<tr>";

                                html += "<td>" + count + "</td>";

                                html += "<td>" + item.patientName + "</td>";

                                html += "<td>" + item.departmentName + "</td>";

                                var statusText = "";

                                switch (item.status) {
                                    case 0:
                                        statusText = "Pending";
                                        break;

                                    case 1:
                                        statusText = "Confirmed";
                                        break;

                                    case 2:
                                        statusText = "Rescheduled";
                                        break;

                                    case 3:
                                        statusText = "Completed";
                                        break;

                                    case 4:
                                        statusText = "Cancelled";
                                        break;
                                }
                                html += "<td>" + statusText + "</td>";

                                html += "<td>";

                                html += '<a href="/Admin/Appointment/SingleAppointment?AppointmentId='
                                    + item.appointmentId +
                                    '" class="btn btn-success btn-sm w-100">View</a>';

                                html += "</td>";

                                html += "<td>" + item.appointmentBookDate + "</td>";

                                html += "</tr>";

                                count++;

                            });

                            $("#AppointmentTableBody").html(html);

                        },

                        error: function (xhr) {

                            console.log(xhr);

                        }

                    });

                });

            });
</script>