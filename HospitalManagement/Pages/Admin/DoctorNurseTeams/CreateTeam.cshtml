@page
@model HospitalManagement.Pages.Admin.Doctor_Nurse_Teams.CreateTeamModel
@{
    Layout = "/Pages/Admin/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="col">
            <div class="card">

                <div class="card-header">
                    <h2 class="mb-0">Create Doctor Nurse Team</h2>
                </div>

                <div class="card-body">

                    <form id="teamForm" method="post">

                        <!-- Team Name -->
                        <div class="mb-3">
                            <label for="teamName" class="form-label">
                                Team Name
                            </label>

                            <input asp-for="DoctorNurseTeamViewModel.TeamName"
                                   type="text"
                                   id="teamName"
                                   class="form-control"
                                   placeholder="Enter Team Name">

                            <span asp-validation-for="DoctorNurseTeamViewModel.TeamName"
                                  class="text-danger"></span>
                        </div>



                        <!-- Department -->
                        <div class="mb-3">
                            <label for="departmentId" class="form-label">
                                Department
                            </label>

                            <select asp-for="DoctorNurseTeamViewModel.DepartmentId"
                                    id="departmentId"
                                    class="form-select"
                                    onchange="GetDoctorsByDepartment(this.value)">

                                <option value="">-- Select Department --</option>

                                @foreach (var item in Model.Departments)
                                {
                                    <option value="@item.DepartmentId">
                                        @item.DepartmentName
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="DoctorNurseTeamViewModel.DepartmentId"
                                  class="text-danger"></span>
                        </div>


                        <!-- Doctor -->
                        <div class="mb-3">
                            <label for="doctorId" class="form-label">
                                Doctor
                            </label>

                            <select asp-for="DoctorNurseTeamViewModel.DoctorId"
                                    id="doctorId"
                                    class="form-select">

                                <option value="">-- Select Doctor --</option>

                            </select>

                            <span asp-validation-for="DoctorNurseTeamViewModel.DoctorId"
                                  class="text-danger"></span>
                        </div>





                        <!-- Description -->
                        <div class="mb-3">
                            <label for="description" class="form-label">
                                Description
                            </label>

                            <textarea asp-for="DoctorNurseTeamViewModel.Description"
                                      class="form-control"
                                      id="description"
                                      rows="5"
                                      style="height: 127px;"
                                      placeholder="Enter Team Description"></textarea>

                            <span asp-validation-for="DoctorNurseTeamViewModel.Description"
                                  class="text-danger"></span>
                        </div>


                        <!-- Status -->
                        <div class="mb-3">
                            <label class="form-label">
                                Status
                            </label>

                            <select asp-for="DoctorNurseTeamViewModel.IsActive"
                                    class="form-select">
                                <option value="" selected >Select Status</option>
                                <option value="true">Active</option>
                                <option value="false">Deactive</option>

                            </select>

                            <span asp-validation-for="DoctorNurseTeamViewModel.IsActive"
                                  class="text-danger"></span>
                        </div>


                        <!-- Save Button -->
                        <button type="submit"
                                class="btn btn-success rounded-pill">
                            Create Team
                        </button>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

@if (TempData["Msg"] != null)
{
    <script>

        alert("@TempData["Msg"]");

        @if (TempData["ClearForm"] != null)
        {
            <text>
                document.getElementById("teamForm").reset();
            </text>
        }

    </script>
}


<script>
    function GetDoctorsByDepartment(departmentId) {

        var doctorDropdown = $("#doctorId");

        doctorDropdown.empty();

        doctorDropdown.append(
            '<option value="">-- Select Doctor --</option>'
        );

        if (!departmentId) {
            return;
        }

        $.ajax({
            url: '?handler=DoctorsByDepartment',
            type: 'GET',
            data: {
                departmentId: departmentId
            },
            success: function (response) {

                console.log(response);

                $.each(response, function (index, doctor) {

                    doctorDropdown.append(
                        $('<option></option>')
                            .val(doctor.doctorNurceId)
                            .text(doctor.firstName + ' ' + doctor.lastName)
                    );

                });
            },
            error: function () {
                alert("Unable to load doctors.");
            }
        });
    }
</script>